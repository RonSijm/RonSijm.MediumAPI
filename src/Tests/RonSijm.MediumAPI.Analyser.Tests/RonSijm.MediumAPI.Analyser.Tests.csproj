<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsTestProject>true</IsTestProject>
		<IsPackable>false</IsPackable>
		<!-- Suppress RS warnings that fire when analyzer source is compiled into a non-analyzer project -->
		<NoWarn>RS1036;RS1038;RS1041;RS2008</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="All" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Reference analyzer as a normal library so tests can instantiate it directly -->
		<ProjectReference Include="..\..\Main\RonSijm.MediumAPI.Analyser\RonSijm.MediumAPI.Analyser.csproj" />
	</ItemGroup>

</Project>
