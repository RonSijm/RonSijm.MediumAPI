<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<Description>Source generator, route analyzers and code fixes for RonSijm.MediumAPI.</Description>
		<PackageTags>roslyn;analyzer;source-generator;aspnetcore;minimal-api</PackageTags>
		<!-- Roslyn loads these DLLs from analyzers/, not from lib/. -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<DevelopmentDependency>true</DevelopmentDependency>
		<!-- Embedded PDBs provide symbols without a separate symbol package. -->
		<DebugType>embedded</DebugType>
		<IncludeSymbols>false</IncludeSymbols>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../RonSijm.MediumAPI.CodeFixes/RonSijm.MediumAPI.CodeFixes.csproj"
						  ReferenceOutputAssembly="false" PrivateAssets="all" Pack="false" />
		<None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="../RonSijm.MediumAPI.CodeFixes/bin/$(Configuration)/netstandard2.0/RonSijm.MediumAPI.CodeFixes.dll"
			  Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>
